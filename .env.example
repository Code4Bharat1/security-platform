# Nexcore Security Portal Frontend - Environment Configuration Template

# Backend API Endpoint URL
NEXT_PUBLIC_PROD_API_URL=http://localhost:5000/api

# Inactivity auto-logout warning interval in milliseconds (defaults to 14 minutes if not specified)
# For local testing, 23 hours = 82800000 ms
NEXT_PUBLIC_WARNING_TIMEOUT=82800000

# Inactivity auto-logout trigger interval in milliseconds (defaults to 15 minutes if not specified)
# For local testing, 24 hours = 86400000 ms
NEXT_PUBLIC_LOGOUT_TIMEOUT=86400000

# Google Auth Client id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=my_super_secret_webhook_key_set_by_dev
